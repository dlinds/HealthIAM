# Copy to .env and adjust. All values are read by config/settings/*.py via django-environ.

# --- Core -------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins, e.g. https://iam.example.org
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=America/Chicago

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://healthiam:healthiam@127.0.0.1:5432/healthiam

# --- Authentication ---------------------------------------------------------
# Allow username/password login (dev only; keep false in production).
AUTH_LOCAL_LOGIN=true

# Entra ID (Azure AD) OIDC. Leave ENTRA_TENANT_ID empty to disable SSO.
ENTRA_TENANT_ID=
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
# Map Entra group object IDs to app roles. Roles: Admin, Help Desk, Auditor.
# Format: <group-guid>=<Role>,<group-guid>=<Role>
ENTRA_GROUP_ROLE_MAP=

# --- Active Directory (LDAPS) -----------------------------------------------
# Optional on-prem AD sync; see docs/ad-setup.md. Everything stays off until both
# AD_SERVER_URIS and AD_BASE_DN are set. Only ldaps:// is accepted and certificate
# verification is always on.
#
# Domain controllers in failover order, comma separated. Use the FQDN printed on
# each DC's certificate, never an IP address.
#AD_SERVER_URIS=ldaps://dc1.corp.example.org,ldaps://dc2.corp.example.org
# Search base of the domain.
#AD_BASE_DN=DC=corp,DC=example,DC=org
# Read-only service account for the bind. AD refuses anonymous searches by default.
#AD_BIND_DN=CN=svc-healthiam,OU=Service Accounts,DC=corp,DC=example,DC=org
#AD_BIND_PASSWORD=
# PEM file with the internal CA that signed the DC certificates. Empty = system
# trust store (fine when the DCs use a publicly trusted CA).
#AD_CA_BUNDLE=/certs/internal-ca.pem
# Connect and receive timeout in seconds (default 10). Raise it if the sync fails
# with a receive timeout on a slow link.
#AD_TIMEOUT=10
# Group whose members (nested groups included) get a HealthIAM login. A DN or a
# sAMAccountName (default IAM-Users).
#AD_USER_GROUP=IAM-Users
# Role every synced login is guaranteed and never loses through the sync
# (default Help Desk). Must be Admin, Help Desk or Auditor.
#AD_BASELINE_ROLE=Help Desk
# OUs to import application groups from, SEMICOLON separated because DNs contain
# commas. Empty = the whole AD_BASE_DN.
#AD_GROUPS_SEARCH_BASES=OU=Application Groups,DC=corp,DC=example,DC=org;OU=Licensing,DC=corp,DC=example,DC=org
# Case-insensitive glob patterns, comma separated. Only matching groups are
# imported, and only access levels whose group name matches are checked for
# broken references; other names show "outside sync filter".
#AD_GROUPS_NAME_PATTERNS=APP_*,LIC_*
#
# Local demo without a domain controller: these two switch the AD pages on so the
# groups loaded by `manage.py seed_demo` are browsable. The host does not exist,
# so Test connection and Sync now fail harmlessly with an error message.
#AD_SERVER_URIS=ldaps://dc.test.invalid
#AD_BASE_DN=DC=test,DC=invalid

# Shown on the "no access" page.
SUPPORT_CONTACT=the Information Security team (infosec@example.org)

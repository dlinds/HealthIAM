# Copy to .env and adjust. All values are read by config/settings/*.py via django-environ.

# --- Core -------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins, e.g. https://iam.example.org
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=America/Chicago

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://healthiam:healthiam@127.0.0.1:5432/healthiam

# --- Authentication ---------------------------------------------------------
# Allow username/password login (dev only; keep false in production).
AUTH_LOCAL_LOGIN=true

# Entra ID (Azure AD) OIDC. Leave ENTRA_TENANT_ID empty to disable SSO.
ENTRA_TENANT_ID=
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
# Map Entra group object IDs to app roles. Roles: Admin, Help Desk, Auditor.
# Format: <group-guid>=<Role>,<group-guid>=<Role>
ENTRA_GROUP_ROLE_MAP=

# --- Active Directory (LDAPS) -----------------------------------------------
# Optional on-prem AD sync; see docs/ad-setup.md. Everything stays off until both
# AD_SERVER_URIS and AD_BASE_DN are set. Only ldaps:// is accepted and certificate
# verification is always on.
#
# Domain controllers in failover order, comma separated. Use the FQDN printed on
# each DC's certificate, never an IP address.
#AD_SERVER_URIS=ldaps://dc1.corp.example.org,ldaps://dc2.corp.example.org
# Search base of the domain.
#AD_BASE_DN=DC=corp,DC=example,DC=org
# Read-only service account for the bind. AD refuses anonymous searches by default.
#AD_BIND_DN=CN=svc-healthiam,OU=Service Accounts,DC=corp,DC=example,DC=org
#AD_BIND_PASSWORD=
# PEM file with the internal CA that signed the DC certificates. Empty = system
# trust store (fine when the DCs use a publicly trusted CA).
#AD_CA_BUNDLE=/certs/internal-ca.pem
# Connect and receive timeout in seconds (default 10). Raise it if the sync fails
# with a receive timeout on a slow link.
#AD_TIMEOUT=10
# Group whose members (nested groups included) get a HealthIAM login. A DN or a
# sAMAccountName (default IAM-Users).
#AD_USER_GROUP=IAM-Users
# Role every synced login is guaranteed and never loses through the sync
# (default Help Desk). Must be Admin, Help Desk or Auditor.
#AD_BASELINE_ROLE=Help Desk
# Which groups to import. The search bases are the main lever and the one to reach for
# first: pointing them at the OUs that hold real access groups excludes AD built-ins
# structurally, with no pattern list to maintain. SEMICOLON separated, because DNs
# contain commas. Empty = the whole AD_BASE_DN.
#AD_GROUPS_SEARCH_BASES=OU=Access Groups,DC=corp,DC=example,DC=org;OU=Licensing,DC=corp,DC=example,DC=org
#
# Case-insensitive glob patterns, comma separated. LEAVE THIS EMPTY unless you really
# only care about a subset: a group outside the patterns is never imported, so an access
# level naming it can never be checked and shows "outside sync filter" forever rather
# than telling you the group is gone. Groups that no application owns -- VPN, file
# shares, printing, badges -- are exactly the ones a narrow prefix list leaves out.
#AD_GROUPS_NAME_PATTERNS=
#
# Globs that keep a group out however it matched above; excludes beat includes, and an
# empty list excludes nothing. The second line of defence after the search bases: AD
# built-ins, and the group that grants access to HealthIAM itself (AD_USER_GROUP), which
# should never become an assignable access level.
#AD_GROUPS_EXCLUDE_PATTERNS=Domain *,Enterprise *,Schema Admins,Cert Publishers,Group Policy Creator Owners,RAS and IAS Servers,Allowed RODC*,Denied RODC*,Read-only Domain Controllers,DnsAdmins,DnsUpdateProxy,Protected Users,Key Admins,Cloneable Domain Controllers,IAM-*
#
# Let synced people sign in with their AD password (the form binds to a DC as them). Without
# this they have a login but no credential unless Entra SSO is configured. See docs/ad-setup.md.
#AD_AUTH_ENABLED=true
# Seconds to wait for the bind. Long on purpose: where an access-control layer in front of the
# domain controllers requires a step-up approval, it holds the bind open until the person
# approves the prompt. The reverse proxy and gunicorn timeouts must both exceed it.
#AD_AUTH_TIMEOUT=60
# Wrong passwords for one login inside the window before HealthIAM stops forwarding attempts
# for the cool-off. Keep the count below your domain's lockout threshold and the cool-off at or
# above its observation window, or AD locks the account before HealthIAM stops trying.
# 0 turns the budget off so every attempt reaches the directory.
#AD_AUTH_MAX_FAILURES=3
#AD_AUTH_FAILURE_WINDOW=1800
#AD_AUTH_LOCKOUT_SECONDS=1800
#
# Local demo without a domain controller: these two switch the AD pages on so the
# groups loaded by `manage.py seed_demo` are browsable. The host does not exist,
# so Test connection and Sync now fail harmlessly with an error message.
#AD_SERVER_URIS=ldaps://dc.test.invalid
#AD_BASE_DN=DC=test,DC=invalid

# Shown on the "no access" page.
SUPPORT_CONTACT=the Information Security team (infosec@example.org)

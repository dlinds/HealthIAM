# Copy to .env and adjust. All values are read by config/settings/*.py via django-environ.

# --- Core -------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins, e.g. https://iam.example.org
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=America/Chicago

# Empty logs to the console, which is what the container and development both want.
# A path sends logging to that file instead (rotating, 10 MB x 5) -- set by the native
# Windows install, where the service has no console to log to. Relative paths are
# resolved against the project directory, not the working directory.
#LOG_FILE=

# The scheduled-sync command shown on Admin > Active Directory. Empty shows the
# container's `docker exec` line, which is right for the TrueNAS deployment and wrong
# for a native install; docs/deploy-windows.md sets it to the Scheduled Task command.
#SYNC_SCHEDULE_COMMAND=

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://healthiam:healthiam@127.0.0.1:5432/healthiam

# --- Authentication ---------------------------------------------------------
# Allow username/password login (dev only; keep false in production).
AUTH_LOCAL_LOGIN=true

# Entra ID (Azure AD) OIDC: on when ENTRA_TENANT_ID and OIDC_RP_CLIENT_ID are both set.
# ENTRA_TENANT_ID also serves the Microsoft Graph sync further down.
ENTRA_TENANT_ID=
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
# Map Entra group object IDs to app roles. Roles: Admin, Help Desk, Auditor.
# Format: <group-guid>=<Role>,<group-guid>=<Role>
ENTRA_GROUP_ROLE_MAP=

# --- Active Directory (LDAPS) -----------------------------------------------
# Optional on-prem AD sync; see docs/ad-setup.md. Everything stays off until both
# AD_SERVER_URIS and AD_BASE_DN are set. Only ldaps:// is accepted and certificate
# verification is always on.
#
# Domain controllers in failover order, comma separated. Use the FQDN printed on
# each DC's certificate, never an IP address.
#AD_SERVER_URIS=ldaps://dc1.corp.example.org,ldaps://dc2.corp.example.org
# Search base of the domain.
#AD_BASE_DN=DC=corp,DC=example,DC=org
# Read-only service account for the bind. AD refuses anonymous searches by default.
#AD_BIND_DN=CN=svc-healthiam,OU=Service Accounts,DC=corp,DC=example,DC=org
#AD_BIND_PASSWORD=
# PEM file with the internal CA that signed the DC certificates. Empty = system
# trust store (fine when the DCs use a publicly trusted CA).
#AD_CA_BUNDLE=/certs/internal-ca.pem
# Connect and receive timeout in seconds (default 10). Raise it if the sync fails
# with a receive timeout on a slow link.
#AD_TIMEOUT=10
# Group whose members (nested groups included) get a HealthIAM login. A DN or a
# sAMAccountName (default IAM-Users).
#AD_USER_GROUP=IAM-Users
# Role every synced login is guaranteed and never loses through the sync
# (default Help Desk). Must be Admin, Help Desk or Auditor.
#AD_BASELINE_ROLE=Help Desk
# Which groups to import. The search bases are the main lever and the one to reach for
# first: pointing them at the OUs that hold real access groups excludes AD built-ins
# structurally, with no pattern list to maintain. SEMICOLON separated, because DNs
# contain commas. Empty = the whole AD_BASE_DN.
#AD_GROUPS_SEARCH_BASES=OU=Access Groups,DC=corp,DC=example,DC=org;OU=Licensing,DC=corp,DC=example,DC=org
#
# Case-insensitive glob patterns, comma separated. LEAVE THIS EMPTY unless you really
# only care about a subset: a group outside the patterns is never imported, so an access
# level naming it can never be checked and shows "outside sync filter" forever rather
# than telling you the group is gone. Groups that no application owns -- VPN, file
# shares, printing, badges -- are exactly the ones a narrow prefix list leaves out.
#AD_GROUPS_NAME_PATTERNS=
#
# Globs that keep a group out however it matched above; excludes beat includes, and an
# empty list excludes nothing. The second line of defence after the search bases: AD
# built-ins, and the group that grants access to HealthIAM itself (AD_USER_GROUP), which
# should never become an assignable access level.
#AD_GROUPS_EXCLUDE_PATTERNS=Domain *,Enterprise *,Schema Admins,Cert Publishers,Group Policy Creator Owners,RAS and IAS Servers,Allowed RODC*,Denied RODC*,Read-only Domain Controllers,DnsAdmins,DnsUpdateProxy,Protected Users,Key Admins,Cloneable Domain Controllers,IAM-*
#
# Account mirror: user accounts under these OUs (SEMICOLON separated) are mirrored and
# linked to people -- by person number, employee ID, network username (docs/ad-setup.md
# section 13) -- so a person's page shows their accounts and the dashboard shows enabled
# accounts of people who have left. Empty = off; there is no
# fallback to the base DN, mirroring every account in the domain is an explicit choice.
#AD_ACCOUNTS_SEARCH_BASES=OU=Staff,DC=corp,DC=example,DC=org;OU=Contractors,DC=corp,DC=example,DC=org
# Globs on the account name that keep an account out of the mirror.
#AD_ACCOUNTS_EXCLUDE_PATTERNS=svc-*,*-adm
# The AD attribute carrying the HR employee ID (default employeeID; some directories use
# employeeNumber). An account whose value matches a person's employee ID is linked to them.
#AD_EMPLOYEE_ID_ATTRIBUTE=employeeID
# The attribute an account carries its HealthIAM person number in (P0001230, on every person
# page): the key for students, travelers, contractors and anyone else HR does not number. Pick
# a free extensionAttribute1..15 -- Entra Connect synchronizes those, so the Entra mirror can
# read it too -- and keep it off employeeID, which is HR's. Empty = off.
#AD_PERSON_NUMBER_ATTRIBUTE=extensionAttribute7
# The letters in front of every person number (default P). Choose before numbers go into AD:
# a number read back is only recognized with the current prefix.
#PERSON_NUMBER_PREFIX=P
# Also link an account no stronger key links by its mail, then its UPN, when exactly one
# person has that address. Only where the e-mail HealthIAM holds comes from IT.
#AD_LINK_BY_EMAIL=false
#
# Let synced people sign in with their AD password (the form binds to a DC as them). Without
# this they have a login but no credential unless Entra SSO is configured. See docs/ad-setup.md.
#AD_AUTH_ENABLED=true
# Seconds to wait for the bind. Long on purpose: where an access-control layer in front of the
# domain controllers requires a step-up approval, it holds the bind open until the person
# approves the prompt. The reverse proxy and gunicorn timeouts must both exceed it.
#AD_AUTH_TIMEOUT=60
# Wrong passwords for one login inside the window before HealthIAM stops forwarding attempts
# for the cool-off. Keep the count below your domain's lockout threshold and the cool-off at or
# above its observation window, or AD locks the account before HealthIAM stops trying.
# 0 turns the budget off so every attempt reaches the directory.
#AD_AUTH_MAX_FAILURES=3
#AD_AUTH_FAILURE_WINDOW=1800
#AD_AUTH_LOCKOUT_SECONDS=1800
#
# Demo directory, for browsing the AD pages without a domain controller.
#
# In DEVELOPMENT you need none of this: with no AD server configured,
# config/settings/dev.py points these settings at the synthetic domain that
# `manage.py seed_demo` writes, so `make seed && make run` shows the group list,
# routes, reference badges and the reports straight away. Set AD_DEMO_DIRECTORY=false
# to turn that off and leave the integration disabled as before.
#AD_DEMO_DIRECTORY=false
#
# Under PRODUCTION settings (the container) nothing is substituted, so uncomment the
# block below to browse seeded demo data there. dc1.demo.local does not exist, so
# Test connection, Sync now and `manage.py sync_ad` fail with an error message; that
# is the expected demo behaviour, not a fault. Simulate an overnight sync that found
# changes with `manage.py demo_ad drift`. See docs/ad-setup.md section 12.
#AD_SERVER_URIS=ldaps://dc1.demo.local
#AD_BASE_DN=DC=demo,DC=local
#AD_BIND_DN=CN=svc-healthiam,OU=Service Accounts,DC=demo,DC=local
#AD_BIND_PASSWORD=demo-only-not-a-real-secret
#AD_GROUPS_SEARCH_BASES=OU=Groups,DC=demo,DC=local
#AD_GROUPS_EXCLUDE_PATTERNS=IAM-*,Domain *,Enterprise *,LIC_RETIRED_*
#AD_ACCOUNTS_SEARCH_BASES=OU=Staff,DC=demo,DC=local

# --- Microsoft Entra ID (Microsoft Graph) -----------------------------------------
# Optional read-only directory sync over Graph; see docs/entra-setup.md, Part 2. It sits
# beside the AD sync above and suits hybrid and cloud-only tenants alike: cloud groups become
# "Entra group" access levels, every account in the tenant (guests included) is mirrored and
# linked to people, and one Entra group can decide who has a login. Off until both
# ENTRA_TENANT_ID (Authentication, above) and ENTRA_SYNC_CLIENT_ID are set.
#
# Its own app registration, not the SSO one, with the application permissions User.Read.All,
# GroupMember.Read.All and Organization.Read.All (plus AuditLog.Read.All for last sign-in).
#ENTRA_SYNC_CLIENT_ID=
# A certificate is preferred: a .pem holding the private key and the certificate, or a
# .pfx/.p12 file. Upload the certificate's public half to the app registration.
#ENTRA_SYNC_CERTIFICATE=/certs/healthiam-sync.pem
#ENTRA_SYNC_CERTIFICATE_PASSWORD=
# ...or a client secret. It expires within two years, and every run then fails.
#ENTRA_SYNC_CLIENT_SECRET=
# National clouds only (docs/entra-setup.md). No trailing slash.
#ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com
#ENTRA_GRAPH_ENDPOINT=https://graph.microsoft.com
# MSAL asks login.microsoftonline.com whether a sign-in host it does not know is Microsoft's
# before sending it the credential. False only for an air-gapped cloud that cannot reach it.
#ENTRA_VALIDATE_AUTHORITY=true
# Seconds per Graph request (default 30).
#ENTRA_TIMEOUT=30
#
# Globs on the group's display name, the AD_GROUPS_* syntax. LEAVE THE PATTERNS EMPTY for the
# reason given for AD_GROUPS_NAME_PATTERNS; exclude instead -- the login group, Teams-backed
# Microsoft 365 groups nobody requests, all-company groups.
#ENTRA_GROUPS_NAME_PATTERNS=
#ENTRA_GROUPS_EXCLUDE_PATTERNS=IAM-*,All Company
#
# Account mirror: every user in the tenant, members and guests, linked to people by person
# number, employee ID or network username (guests also by e-mail). On by default whenever the
# sync is.
#ENTRA_ACCOUNTS_ENABLED=true
# Globs on the userPrincipalName that keep an account out of the mirror.
#ENTRA_ACCOUNTS_EXCLUDE_PATTERNS=svc-*,sync_*
# Where the HR employee ID lives: employeeId (default), an on-premises extension attribute
# (onPremisesExtensionAttributes.extensionAttribute1..15) or a schema extension
# (extension_<appid>_<name>, which is how AD's employeeNumber reaches Entra ID if synced).
#ENTRA_EMPLOYEE_ID_ATTRIBUTE=employeeId
# Where the HealthIAM person number lives, in the same forms: the Entra side of
# AD_PERSON_NUMBER_ATTRIBUTE, e.g. onPremisesExtensionAttributes.extensionAttribute7. Empty = off.
#ENTRA_PERSON_NUMBER_ATTRIBUTE=onPremisesExtensionAttributes.extensionAttribute7
# Guests always link by e-mail; this links members by it too, when no stronger key does.
#ENTRA_LINK_MEMBERS_BY_EMAIL=false
# Last sign-in per account needs Entra ID P1/P2 and AuditLog.Read.All; without them the sync
# carries on without it and says why on the run. False stops asking.
#ENTRA_SIGN_IN_ACTIVITY=true
# Guest worklists: no sign-in for this many days; an invitation unredeemed for this many.
#ENTRA_GUEST_STALE_DAYS=90
#ENTRA_GUEST_PENDING_DAYS=30
#
# Where logins come from: "ad" (AD_USER_GROUP over LDAPS) or "entra" (ENTRA_USER_GROUP over
# Graph). Empty picks AD when it is configured, so an existing AD deployment is unchanged.
#DIRECTORY_LOGIN_SOURCE=entra
# Object ID of the group whose members (nested groups included) get a login, when logins
# come from Entra ID. They sign in with SSO: the sync never stores a password.
#ENTRA_USER_GROUP=
# Role every login the Entra sync manages is guaranteed (default Help Desk).
#ENTRA_BASELINE_ROLE=Help Desk
# The scheduled-sync command shown on Admin > Entra ID, as SYNC_SCHEDULE_COMMAND is for AD.
#ENTRA_SYNC_SCHEDULE_COMMAND=
#
# Demo tenant, for browsing the Entra pages without a tenant.
#
# In DEVELOPMENT you need none of this: with ENTRA_TENANT_ID and ENTRA_SYNC_CLIENT_ID both
# unset, config/settings/dev.py points these settings at the synthetic hybrid tenant that
# `manage.py seed_demo` writes. Set ENTRA_DEMO_TENANT=false to leave the integration off.
#ENTRA_DEMO_TENANT=false
#
# Under PRODUCTION settings nothing is substituted: uncomment the block below, and set
# ENTRA_TENANT_ID above to f98ec700-739c-59b1-ab48-786e6e93f14b -- which SSO shares, so leave
# OIDC_RP_CLIENT_ID unset on a demo instance. Both hosts are under .invalid, so Test
# connection, Sync now and `manage.py sync_entra` fail without reaching Microsoft or sending a
# credential; that is the expected demo behaviour. See docs/entra-setup.md section 17.
#ENTRA_SYNC_CLIENT_ID=94b74301-5d16-595a-9d5a-687a58b419e7
#ENTRA_SYNC_CLIENT_SECRET=demo-only-not-a-real-secret
#ENTRA_AUTHORITY_HOST=https://login.demohealth.invalid
#ENTRA_GRAPH_ENDPOINT=https://graph.demohealth.invalid
#ENTRA_VALIDATE_AUTHORITY=false
#ENTRA_GROUPS_EXCLUDE_PATTERNS=IAM-*

# Shown on the "no access" page.
SUPPORT_CONTACT=the Information Security team (infosec@example.org)

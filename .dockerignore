# Keep build context small and secrets out of the image.
.git
.gitignore
.github
.dockerignore

.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Never ship local config or collected output; both are produced at build/run time.
.env
.env.*
staticfiles/
media/
db.sqlite3
*.log

# Not needed at runtime.
tests/
docs/
deploy/
docker-compose.yml
Makefile
README.md

.idea/
.vscode/
.DS_Store

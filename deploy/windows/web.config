<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse proxy for HealthIAM. Copy to the physical path of the IIS site that holds
  the HTTPS binding (see docs/deploy-windows.md).

  IIS terminates TLS with a certificate from the Windows certificate store and forwards
  to waitress on 127.0.0.1:8000. Requires the URL Rewrite and Application Request
  Routing modules, and ARR's proxy enabled at the server level.

  Everything is proxied, static files included: WhiteNoise serves those in-process
  (config/settings/base.py), so there is nothing for IIS to serve from disk and no
  second copy of the static files to keep in step.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <!--
        HTTP_X_FORWARDED_PROTO has to be declared here before a rule may set it.
        Without this block IIS rejects the rule below outright with HTTP 500.50
        rather than ignoring it.
      -->
      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_PROTO" />
      </allowedServerVariables>
      <rules>
        <rule name="HealthIAM proxy" stopProcessing="true">
          <match url="(.*)" />
          <!--
            ARR does not add X-Forwarded-Proto on its own. config/settings/prod.py trusts
            exactly that header (SECURE_PROXY_SSL_HEADER) to decide a request arrived over
            HTTPS. Leave it out and Django believes every request is plain HTTP: the pages
            still render, but the Secure session and CSRF cookies are never honoured and
            the login form loops back to itself with no error. That silent failure is the
            single most common way this deployment goes wrong.
          -->
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!--
      Uploaded CSV imports. IIS caps a request body at 30 MB by default and answers a
      larger one with 404.13 before the app ever sees it. 60 MB is generous for an HR
      extract; lower it if you would rather cap uploads here.
    -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="62914560" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <!-- Django sets its own security headers; this one only leaks the IIS version. -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- The app renders its own 404 and 403 pages (templates/404.html, 403.html). -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>

# HealthIAM .env for a native Windows Server install (docs/deploy-windows.md).
#
# Install-HealthIAM.ps1 writes this file for you, filling in SECRET_KEY, DATABASE_URL,
# ALLOWED_HOSTS, LOG_FILE and SYNC_SCHEDULE_COMMAND. Keep it here only as the reference
# for what the installer produced and what you may edit afterwards. Restart the service
# after any change: settings are read once, at start.
#
# Every key is documented in .env.example at the repository root; this file covers the
# ones whose value differs on Windows.
#
# Three rules this file has to follow, all of them silent when broken:
#
#   1. Do not quote values. A double-quoted value has its backslash escapes processed,
#      so AD_CA_BUNDLE="C:\certs\ca.pem" arrives as C:certsca.pem. Leave paths bare,
#      or write them with forward slashes, which Windows accepts everywhere.
#   2. Save as UTF-8 WITHOUT a byte order mark. A BOM makes the first line unparseable
#      and that variable simply never arrives. Note that Set-Content -Encoding UTF8
#      writes a BOM in Windows PowerShell 5.1.
#   3. Keep @ : / ? # % out of the database password, or percent-encode them --
#      DATABASE_URL is a URL and those characters end the field early.

# --- Core -------------------------------------------------------------------
# Generate with:
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing it later signs everybody out. It is not a password; never reuse one here.
SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
DEBUG=false

# Hostnames this server answers on, no scheme. The FQDN people type must be here, or
# Django answers DisallowedHost. IIS must also be set to preserve the client Host
# header, or every request arrives claiming to be 127.0.0.1:8000.
ALLOWED_HOSTS=iam.corp.example.org

# The HTTPS origins of the IIS site in front, with scheme. Without this, every form
# post is rejected as a CSRF failure.
CSRF_TRUSTED_ORIGINS=https://iam.corp.example.org

TIME_ZONE=America/Chicago

# IIS terminates TLS and the proxy rule sets X-Forwarded-Proto, which prod settings
# trust. Redirecting again here would loop, because waitress only ever sees HTTP.
SECURE_SSL_REDIRECT=false

# --- Logging ----------------------------------------------------------------
# A Windows service has no console, so without this the log goes nowhere. Rotates at
# 10 MB, five kept. The directory must exist and be writable by the service account.
# Give the scheduled sync its own file (the Scheduled Task sets LOG_FILE separately):
# two processes rotating the same file on Windows will collide over the rename.
LOG_FILE=C:\HealthIAM\logs\healthiam.log

# --- Database ---------------------------------------------------------------
# PostgreSQL 16 on this host. The password is the one the installer set on the role.
DATABASE_URL=postgres://healthiam:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/healthiam

# --- Authentication ---------------------------------------------------------
# Keep at least one local account working, so a domain controller outage or a broken
# AD_BIND_PASSWORD does not lock the administrators out of their own IAM system.
AUTH_LOCAL_LOGIN=true

# Entra ID SSO, optional. See docs/entra-setup.md.
#ENTRA_TENANT_ID=
#OIDC_RP_CLIENT_ID=
#OIDC_RP_CLIENT_SECRET=
#ENTRA_GROUP_ROLE_MAP=

# --- Scheduled sync ---------------------------------------------------------
# Shown on Admin > Active Directory so the operator sees the command that actually
# works on this deployment. There is no container here to `docker exec` into, which is
# what the page would otherwise suggest.
SYNC_SCHEDULE_COMMAND=schtasks /Run /TN "HealthIAM AD sync"

# --- Active Directory (LDAPS) -----------------------------------------------
# The full reference is docs/ad-setup.md; only the Windows differences are noted here.
# Everything stays off until both AD_SERVER_URIS and AD_BASE_DN are set.
#
# FQDNs as printed on each domain controller's certificate, in failover order. An IP
# address or a short name fails verification, which is never disabled.
#AD_SERVER_URIS=ldaps://dc1.corp.example.org,ldaps://dc2.corp.example.org
#AD_BASE_DN=DC=corp,DC=example,DC=org
#AD_BIND_DN=CN=svc-healthiam,OU=Service Accounts,DC=corp,DC=example,DC=org
#AD_BIND_PASSWORD=
#
# LEAVE THIS EMPTY FIRST on a domain-joined server. Empty means Python's default trust
# store, and on Windows that is loaded from the machine's own ROOT and CA certificate
# stores -- which already hold the enterprise CA, pushed by Group Policy. So the PEM
# file the container has to bind-mount is usually unnecessary here.
# Confirm with Admin > Active Directory > Test connection. Only if that fails with a
# certificate error does the CA need exporting to a PEM and naming below; that happens
# when the CA reached the machine through Enterprise Trust or a user store rather than
# the machine ROOT store.
#AD_CA_BUNDLE=C:\HealthIAM\certs\internal-ca.pem
#
#AD_TIMEOUT=10
#AD_USER_GROUP=IAM-Users
#AD_BASELINE_ROLE=Help Desk
#AD_GROUPS_SEARCH_BASES=OU=Access Groups,DC=corp,DC=example,DC=org
#AD_GROUPS_NAME_PATTERNS=
#AD_GROUPS_EXCLUDE_PATTERNS=Domain *,Enterprise *,Schema Admins,Cert Publishers,Group Policy Creator Owners,RAS and IAS Servers,Allowed RODC*,Denied RODC*,Read-only Domain Controllers,DnsAdmins,DnsUpdateProxy,Protected Users,Key Admins,Cloneable Domain Controllers,IAM-*
#
# Let synced people sign in with their AD password.
#AD_AUTH_ENABLED=true
#AD_AUTH_TIMEOUT=60
#AD_AUTH_MAX_FAILURES=3
#AD_AUTH_FAILURE_WINDOW=1800
#AD_AUTH_LOCKOUT_SECONDS=1800

# Shown on the "no access" page.
SUPPORT_CONTACT=the Information Security team (infosec@example.org)
